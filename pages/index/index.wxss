.index-page {
  padding-bottom: 180rpx;
}

.hero {
  padding: 34rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.hero::after {
  content: "";
  position: absolute;
  right: -34rpx;
  bottom: -60rpx;
  width: 230rpx;
  height: 170rpx;
  border-radius: 60% 40% 50% 45%;
  background: rgba(255, 217, 157, 0.38);
  transform: rotate(-12deg);
}

.hero-kicker {
  margin-bottom: 16rpx;
  color: #b88767;
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.hero-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
}

.hero-title {
  color: #4f4037;
  font-size: 52rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.hero-subtitle {
  max-width: 488rpx;
  margin-top: 12rpx;
  color: #8f7d70;
  font-size: 27rpx;
  line-height: 1.55;
}

.hero-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  flex: 0 0 auto;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.64);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.8);
  font-size: 52rpx;
}

.toolbar {
  padding: 24rpx 20rpx 20rpx;
  margin-bottom: 24rpx;
}

.category-scroll {
  width: 100%;
  height: 92rpx;
  box-sizing: border-box;
  padding-top: 10rpx;
  padding-bottom: 12rpx;
  white-space: nowrap;
}

.category-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: 64rpx;
  box-sizing: border-box;
  padding: 0 24rpx;
  margin-top: 4rpx;
  margin-right: 12rpx;
  margin-bottom: 4rpx;
  border: 1rpx solid rgba(217, 190, 162, 0.38);
  border-radius: 999rpx;
  color: #8f7a69;
  background: rgba(255, 255, 255, 0.52);
  font-size: 26rpx;
  vertical-align: top;
  transition: background 180ms ease, box-shadow 180ms ease;
}

.category-chip.active {
  color: #4f4037;
  background: rgba(255, 250, 244, 0.92);
  box-shadow: inset 0 0 0 1rpx rgba(199, 119, 90, 0.16), 0 10rpx 24rpx rgba(168, 124, 92, 0.13);
}

.category-icon {
  font-size: 28rpx;
}

.sort-switch {
  display: flex;
  gap: 12rpx;
  padding: 8rpx;
  margin-top: 18rpx;
  border-radius: 999rpx;
  background: rgba(226, 200, 170, 0.2);
}

.sort-item {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 58rpx;
  border-radius: 999rpx;
  color: #9a8678;
  font-size: 25rpx;
  font-weight: 700;
}

.sort-item.active {
  color: #fffaf4;
  background: linear-gradient(135deg, #d98261, #e6ad72);
  box-shadow: 0 10rpx 22rpx rgba(199, 119, 90, 0.18);
}

.message-scroll {
  position: relative;
  z-index: 1;
  height: calc(100vh - 390rpx);
  min-height: 620rpx;
}

.message-card {
  padding: 30rpx;
  margin-bottom: 24rpx;
  animation: note-float-in 520ms ease both;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 22rpx;
}

.category-pill {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  min-height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 750;
}

.time-text {
  color: #ad9c8f;
  font-size: 23rpx;
}

.target-line {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  max-width: 100%;
  padding: 10rpx 16rpx;
  margin-bottom: 18rpx;
  border-radius: 999rpx;
  color: #9a6d4f;
  background: rgba(255, 239, 218, 0.72);
  font-size: 23rpx;
  font-weight: 750;
}

.message-content {
  color: #514039;
  font-size: 32rpx;
  font-weight: 650;
  line-height: 1.72;
  letter-spacing: 0.3rpx;
  word-break: break-all;
}

.interaction-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 26rpx;
}

.like-btn,
.reaction-btn {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  min-width: 76rpx;
  height: 58rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: #947f70;
  background: rgba(255, 255, 255, 0.58);
  border: 1rpx solid rgba(226, 200, 170, 0.38);
  font-size: 25rpx;
}

.like-btn.liked {
  color: #c86555;
  background: rgba(255, 229, 219, 0.82);
}

.heart {
  font-size: 30rpx;
  transform: translateY(-1rpx);
}

.reaction-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.reaction-btn.active {
  color: #6b7f57;
  background: rgba(228, 239, 211, 0.82);
}

.reaction-count {
  min-width: 18rpx;
  font-size: 22rpx;
}

.identity-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 22rpx;
  margin-top: 24rpx;
  border-radius: 28rpx;
}

.identity-box.unlocked {
  background: linear-gradient(135deg, rgba(232, 242, 218, 0.86), rgba(255, 247, 230, 0.92));
}

.identity-box.locked {
  align-items: flex-start;
  background: rgba(255, 255, 255, 0.48);
  border: 1rpx dashed rgba(203, 169, 129, 0.52);
}

.identity-label {
  color: #ad927c;
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.identity-name {
  margin-top: 8rpx;
  color: #536943;
  font-size: 32rpx;
  font-weight: 850;
}

.identity-mark {
  font-size: 44rpx;
}

.lock-copy {
  flex: 1;
  min-width: 0;
}

.lock-tip {
  margin-top: 8rpx;
  color: #8d7b6e;
  font-size: 24rpx;
  line-height: 1.45;
}

.unlock-actions {
  display: flex;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 10rpx;
  max-width: 340rpx;
}

.mini-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 54rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: #fffaf4;
  background: #d98261;
  font-size: 22rpx;
  font-weight: 750;
}

.mini-action.send {
  background: #769b65;
}

.mini-action.muted {
  color: #8a7667;
  background: rgba(255, 255, 255, 0.74);
}

.report-link {
  display: inline-flex;
  align-items: center;
  margin-top: 18rpx;
  color: #b5a396;
  font-size: 22rpx;
}

.fab-movable-area {
  position: fixed;
  left: 0;
  top: 0;
  width: 100vw;
  height: 100vh;
  z-index: 8;
  pointer-events: none;
}

.fab-movable {
  width: 226rpx;
  height: 96rpx;
  pointer-events: auto;
}

.fab {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  width: 226rpx;
  height: 96rpx;
  box-sizing: border-box;
  padding: 0 28rpx;
  border-radius: 999rpx;
  color: #fffaf4;
  font-size: 30rpx;
  font-weight: 850;
  background: linear-gradient(135deg, #d98261, #e9b973);
  box-shadow: 0 24rpx 52rpx rgba(168, 101, 72, 0.3);
}

.fab-icon {
  font-size: 34rpx;
  line-height: 1;
}

.profile-modal-mask {
  position: fixed;
  inset: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 42rpx;
  background: rgba(80, 61, 48, 0.28);
  backdrop-filter: blur(10rpx);
}

.profile-modal {
  width: 100%;
  max-width: 640rpx;
  padding: 38rpx;
  border-radius: 38rpx;
  background: rgba(255, 252, 246, 0.94);
}

.profile-modal-kicker {
  color: #c07d5e;
  font-size: 21rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
}

.profile-modal-title {
  margin-top: 12rpx;
  color: #4f4037;
  font-size: 40rpx;
  font-weight: 900;
}

.profile-modal-note {
  margin-top: 14rpx;
  color: #8f7d70;
  font-size: 25rpx;
  line-height: 1.55;
}

.nickname-input-wrap {
  margin-top: 28rpx;
  padding: 0 24rpx;
  border: 1rpx solid rgba(224, 190, 156, 0.48);
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.72);
}

.nickname-input {
  height: 88rpx;
  color: #514039;
  font-size: 30rpx;
}

.nickname-error {
  margin-top: 14rpx;
  color: #c86555;
  font-size: 24rpx;
}

.nickname-counter {
  margin-top: 12rpx;
  color: #b2a093;
  font-size: 22rpx;
  text-align: right;
}

.profile-modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 26rpx;
}

.profile-action {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 82rpx;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 850;
}

.profile-action.secondary {
  color: #8c6d55;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(213, 182, 150, 0.5);
}

.profile-action.primary {
  color: #fffaf4;
  background: linear-gradient(135deg, #d98261, #e9b973);
  box-shadow: 0 16rpx 32rpx rgba(168, 101, 72, 0.22);
}
