.publish-page {
  padding-bottom: calc(260rpx + env(safe-area-inset-bottom));
}

.publish-hero {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 34rpx;
  margin-bottom: 24rpx;
}

.paper-plane {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  flex: 0 0 auto;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.64);
  font-size: 54rpx;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.86);
}

.hero-copy {
  flex: 1;
  min-width: 0;
}

.page-title {
  color: #4f4037;
  font-size: 44rpx;
  font-weight: 900;
}

.page-subtitle {
  margin-top: 10rpx;
  color: #8f7d70;
  font-size: 26rpx;
  line-height: 1.5;
}

.group-scope {
  display: inline-flex;
  margin-top: 16rpx;
  padding: 8rpx 18rpx;
  border: 1rpx solid rgba(199, 119, 90, 0.18);
  border-radius: 999rpx;
  color: #a86548;
  font-size: 23rpx;
  font-weight: 750;
  background: rgba(255, 248, 239, 0.72);
}

.section {
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 22rpx;
}

.section-title {
  color: #55463e;
  font-size: 32rpx;
  font-weight: 850;
}

.section > .section-title {
  margin-bottom: 22rpx;
}

.section-note {
  margin-top: 8rpx;
  color: #a39184;
  font-size: 24rpx;
  line-height: 1.45;
}

.sender-section {
  position: relative;
}

.sender-status {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 22rpx;
  padding: 22rpx 24rpx;
  border-radius: 26rpx;
  color: #536943;
  background: rgba(230, 242, 214, 0.74);
  border: 1rpx solid rgba(126, 157, 94, 0.22);
}

.sender-status.missing {
  color: #9a6b51;
  background: rgba(255, 239, 218, 0.78);
  border-color: rgba(199, 119, 90, 0.18);
}

.sender-status-label {
  color: #9b8778;
  font-size: 22rpx;
  font-weight: 800;
}

.sender-status-name {
  margin-top: 8rpx;
  color: inherit;
  font-size: 30rpx;
  font-weight: 850;
}

.sender-status-mark {
  flex: 0 0 auto;
  font-size: 36rpx;
  font-weight: 900;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.category-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  min-height: 132rpx;
  border: 1rpx solid rgba(218, 188, 153, 0.34);
  border-radius: 28rpx;
  color: #8f7a69;
  background: rgba(255, 255, 255, 0.52);
  font-size: 25rpx;
  font-weight: 750;
}

.category-card.active {
  color: #4f4037;
  background: rgba(255, 250, 244, 0.9);
  box-shadow: 0 14rpx 28rpx rgba(168, 124, 92, 0.12);
  transform: translateY(-2rpx);
}

.category-card-icon {
  font-size: 42rpx;
}

.target-preview {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 22rpx;
  padding: 18rpx 22rpx;
  border-radius: 24rpx;
  color: #6f604f;
  background: rgba(255, 245, 229, 0.78);
  border: 1rpx solid rgba(224, 197, 168, 0.42);
  font-size: 25rpx;
  font-weight: 750;
}

.target-edit {
  flex: 0 0 auto;
  color: #c7775a;
  font-size: 23rpx;
}

.unlock-setting {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 18rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid rgba(229, 157, 179, 0.3);
  border-radius: 26rpx;
  background: rgba(255, 244, 248, 0.76);
}

.unlock-setting-copy {
  flex: 1;
  min-width: 0;
}

.unlock-setting-title {
  color: #6f4c5a;
  font-size: 26rpx;
  font-weight: 850;
}

.unlock-setting-note {
  margin-top: 8rpx;
  color: #a98691;
  font-size: 22rpx;
  line-height: 1.45;
}

.unlock-check {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  flex: 0 0 auto;
  border: 2rpx solid rgba(202, 142, 160, 0.56);
  border-radius: 14rpx;
  color: #fffaf4;
  background: rgba(255, 255, 255, 0.72);
  font-size: 27rpx;
  font-weight: 900;
}

.unlock-check.checked {
  border-color: rgba(210, 112, 143, 0.88);
  background: linear-gradient(135deg, #d982a0, #e9b27e);
}

.mode-tag {
  min-width: 76rpx;
  height: 44rpx;
  border-radius: 999rpx;
  color: #779060;
  background: rgba(229, 240, 213, 0.88);
  text-align: center;
  line-height: 44rpx;
  font-size: 22rpx;
  font-weight: 800;
}

.template-actions {
  display: flex;
  align-items: center;
  flex: 0 0 auto;
  gap: 10rpx;
}

.refresh-tag {
  min-width: 94rpx;
  color: #9a6b51;
  background: rgba(255, 239, 218, 0.82);
}

.template-card {
  display: block;
  box-sizing: border-box;
  width: 100%;
  padding: 24rpx 26rpx;
  margin-bottom: 14rpx;
  border-radius: 28rpx;
  color: #5d4a40;
  background: rgba(255, 255, 255, 0.58);
  border: 1rpx solid rgba(224, 197, 168, 0.36);
  font-size: 28rpx;
  line-height: 1.55;
  text-align: left;
}

.template-card.active {
  color: #455f36;
  background: linear-gradient(135deg, rgba(230, 242, 214, 0.88), rgba(255, 250, 240, 0.9));
  border-color: rgba(126, 157, 94, 0.36);
}

.template-placeholder {
  padding: 34rpx 28rpx;
  border-radius: 28rpx;
  color: #a39184;
  background: rgba(255, 255, 255, 0.48);
  border: 1rpx dashed rgba(224, 197, 168, 0.52);
  font-size: 26rpx;
  line-height: 1.55;
  text-align: center;
}

.custom-entry {
  flex: 0 0 auto;
  min-height: 62rpx;
  font-size: 23rpx;
}

.custom-section {
  margin-bottom: 24rpx;
}

.textarea-wrap {
  position: relative;
  padding: 22rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.58);
  border: 1rpx solid rgba(224, 197, 168, 0.36);
}

.custom-textarea {
  width: 100%;
  min-height: 180rpx;
  color: #514039;
  font-size: 29rpx;
  line-height: 1.65;
}

.counter {
  margin-top: 12rpx;
  color: #ad9c8f;
  font-size: 22rpx;
  text-align: right;
}

.target-modal-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
  background: rgba(70, 52, 40, 0.24);
}

.target-modal {
  width: 100%;
  padding: 34rpx;
}

.target-modal-title {
  color: #4f4037;
  font-size: 34rpx;
  font-weight: 900;
}

.target-modal-note {
  margin-top: 10rpx;
  color: #9b8778;
  font-size: 24rpx;
  line-height: 1.45;
}

.target-input-wrap {
  margin-top: 26rpx;
  padding: 0 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(224, 197, 168, 0.44);
}

.target-input {
  width: 100%;
  height: 82rpx;
  color: #514039;
  font-size: 30rpx;
  font-weight: 700;
}

.target-counter {
  margin-top: 12rpx;
  color: #ad9c8f;
  font-size: 22rpx;
  text-align: right;
}

.target-modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.target-action {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 76rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 850;
}

.target-action.secondary {
  color: #8b7668;
  background: rgba(255, 255, 255, 0.66);
  border: 1rpx solid rgba(218, 188, 153, 0.36);
}

.target-action.primary {
  color: #fffaf4;
  background: linear-gradient(135deg, #d98261, #e6ad72);
  box-shadow: 0 12rpx 24rpx rgba(199, 119, 90, 0.18);
}

.publish-action-bar {
  position: fixed;
  right: 28rpx;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  left: 28rpx;
  z-index: 10;
  box-sizing: border-box;
  padding: 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  border-radius: 34rpx;
  background: rgba(255, 252, 246, 0.9);
  box-shadow: 0 22rpx 54rpx rgba(157, 117, 91, 0.2);
  backdrop-filter: blur(18rpx);
}

.publish-action-hint {
  margin-bottom: 12rpx;
  color: #9b8778;
  font-size: 22rpx;
  font-weight: 750;
  line-height: 1.35;
  text-align: center;
}

.publish-btn {
  width: 100%;
  min-height: 82rpx;
  box-sizing: border-box;
  font-size: 29rpx;
}

.share-modal-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 42rpx;
  background: rgba(70, 52, 40, 0.28);
  backdrop-filter: blur(10rpx);
}

.share-modal {
  width: 100%;
  padding: 38rpx;
  border-radius: 38rpx;
  background: rgba(255, 252, 246, 0.95);
}

.share-modal-kicker {
  color: #c07d5e;
  font-size: 21rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
}

.share-modal-title {
  margin-top: 12rpx;
  color: #4f4037;
  font-size: 38rpx;
  font-weight: 900;
}

.share-modal-note {
  margin-top: 14rpx;
  color: #8f7d70;
  font-size: 25rpx;
  line-height: 1.55;
}

.share-modal-cancel {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  margin-top: 16rpx;
  border-radius: 999rpx;
  color: #8b7668;
  background: rgba(255, 255, 255, 0.68);
  border: 1rpx solid rgba(218, 188, 153, 0.34);
  font-size: 25rpx;
  font-weight: 820;
}
