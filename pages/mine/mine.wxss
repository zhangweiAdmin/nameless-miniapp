.mine-page {
  padding-bottom: 72rpx;
}

.mine-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 34rpx;
  margin-bottom: 24rpx;
}

.page-title {
  color: #4f4037;
  font-size: 44rpx;
  font-weight: 900;
}

.page-subtitle {
  max-width: 500rpx;
  margin-top: 10rpx;
  color: #8f7d70;
  font-size: 26rpx;
  line-height: 1.5;
}

.profile-seal {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 98rpx;
  height: 98rpx;
  flex: 0 0 auto;
  border-radius: 34rpx;
  color: #fffaf4;
  font-size: 42rpx;
  font-weight: 900;
  background: linear-gradient(135deg, #d98261, #e9b973);
  box-shadow: 0 16rpx 32rpx rgba(168, 101, 72, 0.24);
}

.stats-row {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
  margin-bottom: 24rpx;
}

.stat-card {
  padding: 28rpx;
}

.stat-num {
  color: #4f4037;
  font-size: 50rpx;
  font-weight: 900;
}

.stat-label {
  margin-top: 6rpx;
  color: #a18f82;
  font-size: 24rpx;
}

.panel-switch {
  display: flex;
  gap: 8rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  border-radius: 999rpx;
}

.panel-tab {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 62rpx;
  border-radius: 999rpx;
  color: #9a8678;
  font-size: 24rpx;
  font-weight: 800;
}

.panel-tab.active {
  color: #fffaf4;
  background: linear-gradient(135deg, #d98261, #e6ad72);
  box-shadow: 0 10rpx 22rpx rgba(199, 119, 90, 0.18);
}

.mine-card,
.group-card {
  padding: 30rpx;
  margin-bottom: 22rpx;
  animation: note-float-in 520ms ease both;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 20rpx;
}

.category-pill {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  min-height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: #8b755f;
  background: rgba(255, 244, 228, 0.76);
  font-size: 24rpx;
  font-weight: 750;
}

.time-text {
  color: #ad9c8f;
  font-size: 23rpx;
}

.target-line {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  max-width: 100%;
  padding: 10rpx 16rpx;
  margin-bottom: 16rpx;
  border-radius: 999rpx;
  color: #9a6d4f;
  background: rgba(255, 239, 218, 0.72);
  font-size: 23rpx;
  font-weight: 750;
}

.mine-content {
  color: #514039;
  font-size: 30rpx;
  font-weight: 650;
  line-height: 1.65;
}

.mine-meta {
  display: flex;
  gap: 22rpx;
  margin-top: 20rpx;
  color: #9a8678;
  font-size: 24rpx;
}

.delete-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 54rpx;
  padding: 0 22rpx;
  margin-top: 22rpx;
  border-radius: 999rpx;
  color: #b35d51;
  background: rgba(255, 232, 226, 0.76);
  font-size: 23rpx;
  font-weight: 800;
}

.unlock-card {
  background: rgba(255, 253, 248, 0.82);
}

.sender-line {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  color: #536943;
  background: rgba(230, 242, 214, 0.76);
  font-size: 26rpx;
  font-weight: 800;
}

.section-title {
  color: #55463e;
  font-size: 32rpx;
  font-weight: 850;
}

.section-note {
  margin-top: 8rpx;
  color: #a39184;
  font-size: 24rpx;
  line-height: 1.45;
}

.name-input-wrap {
  margin-top: 24rpx;
  padding: 0 22rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.62);
  border: 1rpx solid rgba(224, 197, 168, 0.36);
}

.name-input {
  height: 88rpx;
  color: #514039;
  font-size: 30rpx;
}

.modify-note {
  margin: 18rpx 0 22rpx;
  color: #a39184;
  font-size: 24rpx;
}

.save-btn {
  width: 100%;
  box-sizing: border-box;
}
