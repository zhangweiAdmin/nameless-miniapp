<view class="container mine-page">
  <view class="soft-orb one"></view>
  <view class="soft-orb two"></view>

  <view class="mine-hero glass-card">
    <view>
      <view class="page-title">我的悄悄话纸条</view>
      <view class="page-subtitle">查看你投递过的纸条，也收藏那些被你解锁的发送者昵称。</view>
    </view>
    <view class="profile-seal">盒</view>
  </view>

  <view class="stats-row">
    <view class="stat-card glass-card">
      <view class="stat-num">{{myMessages.length}}</view>
      <view class="stat-label">投递纸条</view>
    </view>
    <view class="stat-card glass-card">
      <view class="stat-num">{{unlockRecords.length}}</view>
      <view class="stat-label">解锁记录</view>
    </view>
  </view>

  <view class="panel-switch glass-card">
    <view class="panel-tab {{activePanel == 'messages' ? 'active' : ''}}" data-panel="messages" bindtap="switchPanel" hover-class="pressing">我发的纸条</view>
    <view class="panel-tab {{activePanel == 'unlocks' ? 'active' : ''}}" data-panel="unlocks" bindtap="switchPanel" hover-class="pressing">我解锁的纸条</view>
    <view class="panel-tab {{activePanel == 'group' ? 'active' : ''}}" data-panel="group" bindtap="switchPanel" hover-class="pressing">群管理</view>
  </view>

  <view wx:if="{{loading}}" class="loading-line">正在整理你的小纸条...</view>

  <view wx:if="{{!loading && activePanel == 'messages'}}" class="panel-body">
    <block wx:if="{{myMessages.length}}">
      <block wx:for="{{myMessages}}" wx:key="_id">
        <view class="mine-card glass-card">
          <view class="card-head">
            <view class="category-pill">
              <text>{{item.categoryIcon}}</text>
              <text>{{item.categoryLabel}}</text>
            </view>
            <text class="time-text">{{item.formattedTime}}</text>
          </view>
          <view wx:if="{{item.targetName}}" class="target-line">
            <text>写给：</text>
            <text>{{item.targetName}}</text>
          </view>
          <view class="mine-content">{{item.content}}</view>
          <view class="mine-meta">
            <text>♥ {{item.likeCount || 0}}</text>
            <text>解锁 {{item.unlockCount || 0}}</text>
          </view>
          <view class="delete-btn" data-id="{{item._id}}" bindtap="deleteMyMessage" hover-class="pressing">删除</view>
        </view>
      </block>
    </block>
    <view wx:else class="empty-state glass-card">
      <text class="empty-illustration">✉️</text>
      <view>你还没有投递过纸条。</view>
    </view>
  </view>

  <view wx:if="{{!loading && activePanel == 'unlocks'}}" class="panel-body">
    <block wx:if="{{unlockRecords.length}}">
      <block wx:for="{{unlockRecords}}" wx:key="_id">
        <view class="mine-card glass-card unlock-card">
          <view class="card-head">
            <view class="category-pill">
              <text>{{item.categoryIcon}}</text>
              <text>{{item.categoryLabel}}</text>
            </view>
            <text class="time-text">{{item.formattedTime}}</text>
          </view>
          <view wx:if="{{item.targetName}}" class="target-line">
            <text>写给：</text>
            <text>{{item.targetName}}</text>
          </view>
          <view class="mine-content">{{item.contentSnapshot || '这张纸条已删除，保留历史解锁记录。'}}</view>
          <view class="sender-line">发送者昵称：{{item.senderNickname || '暂未确认昵称'}}</view>
        </view>
      </block>
    </block>
    <view wx:else class="empty-state glass-card">
      <text class="empty-illustration">🔐</text>
      <view>还没有解锁过发送者昵称。</view>
    </view>
  </view>

  <view wx:if="{{!loading && activePanel == 'group'}}" class="panel-body">
    <view class="group-card glass-card" wx:if="{{groupInfo.isCreator}}">
      <view class="section-title">群名称</view>
      <view class="section-note">这个名称会显示在首页和分享卡片里。默认“群隐盒悄悄话”，最多 6 个字。</view>
      <view class="name-input-wrap">
        <input class="name-input" maxlength="6" value="{{groupNameInput}}" bindinput="onGroupNameInput" placeholder="输入群名称" />
      </view>
      <view class="modify-note">已修改 {{groupInfo.modifyCount || 0}} 次</view>
      <view class="primary-btn save-btn {{savingGroup ? 'disabled' : ''}}" bindtap="submitGroupName" hover-class="pressing">{{savingGroup ? '保存中' : '保存群名'}}</view>
    </view>

    <view class="empty-state glass-card" wx:else>
      <text class="empty-illustration">🌥️</text>
      <block wx:if="{{groupInfo.openGid}}">
        <view>当前群已有管理员。</view>
        <view>只有第一个把群隐盒悄悄话分享进这个群并完成群绑定的人，可以修改这个群的显示名称。</view>
      </block>
      <block wx:else>
        <view>暂时没有可管理的群。</view>
        <view>请先把群隐盒悄悄话分享到群，再从群里的卡片进入。</view>
      </block>
    </view>
  </view>
</view>
