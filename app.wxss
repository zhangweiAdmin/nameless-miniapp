page {
  min-height: 100%;
  color: #4b403a;
  background: linear-gradient(160deg, #fff7ec 0%, #f9e2d6 42%, #eaf1df 100%);
  font-family: "TsangerYuYangT", "LXGW WenKai", "PingFang SC", sans-serif;
  font-size: 28rpx;
}

.container {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 28rpx 140rpx;
  position: relative;
  overflow: hidden;
}

.soft-orb {
  position: fixed;
  border-radius: 999rpx;
  filter: blur(2rpx);
  opacity: 0.72;
  pointer-events: none;
  z-index: 0;
}

.soft-orb.one {
  top: 48rpx;
  right: -88rpx;
  width: 260rpx;
  height: 260rpx;
  background: rgba(255, 203, 164, 0.62);
}

.soft-orb.two {
  left: -120rpx;
  bottom: 120rpx;
  width: 320rpx;
  height: 320rpx;
  background: rgba(203, 221, 183, 0.54);
}

.glass-card {
  position: relative;
  z-index: 1;
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.76);
  border-radius: 36rpx;
  background: rgba(255, 252, 246, 0.78);
  box-shadow: 0 22rpx 70rpx rgba(157, 117, 91, 0.12);
  backdrop-filter: blur(18rpx);
}

.pressing {
  opacity: 0.82;
  transform: scale(0.98);
}

.disabled {
  opacity: 0.58;
  pointer-events: none;
}

.primary-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 34rpx;
  border-radius: 999rpx;
  color: #fffaf4;
  font-weight: 700;
  letter-spacing: 1rpx;
  background: linear-gradient(135deg, #de8a65 0%, #e6ad72 100%);
  box-shadow: 0 18rpx 34rpx rgba(199, 119, 90, 0.24);
}

.ghost-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  color: #8c6d55;
  font-weight: 650;
  background: rgba(255, 255, 255, 0.64);
  border: 1rpx solid rgba(213, 182, 150, 0.46);
}

.empty-state {
  position: relative;
  z-index: 1;
  padding: 88rpx 42rpx;
  text-align: center;
  color: #9f8f83;
}

.empty-illustration {
  display: block;
  margin-bottom: 18rpx;
  font-size: 76rpx;
}

.loading-line {
  padding: 32rpx 0 12rpx;
  color: #b1a195;
  text-align: center;
}

@keyframes note-float-in {
  from {
    opacity: 0;
    transform: translateY(36rpx) rotate(-2deg) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translateY(0) rotate(0) scale(1);
  }
}
